# PCT Backend Configuration
PCT_HOST=127.0.0.1
PCT_PORT=8000
PCT_LOG_LEVEL=INFO
PCT_SECRET_KEY=change-me-to-a-random-string
PCT_CORS_ORIGIN=http://localhost:5173
PCT_GOOGLE_CLIENT_ID=your-google-client-id-here
PCT_USER_DATA_DIR=

# Project (PCT_PROJECT_ROOT is required)
PCT_PROJECT_ROOT=/path/to/your/project
# PCT_ROOT defaults to one directory above backend/ (the repo root)
# PCT_ROOT=/path/to/pct/repo

# Frontend (also set in frontend/.env)
# VITE_API_URL=http://localhost:8000
# VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
